// Top bar: clock + system tray, flush in the top-right corner. 9px monospace,
// black/white, sharp corners, no padding.
//
// The layer surface spans the whole width, so the surface is transparent and
// the black block is drawn around `.modules-right`, which shrinks to fit and
// sits flush against the top-right corner.
//
// labwc: start from ~/.config/labwc/autostart:
//   waybar --log-level off &
//   waybar -c ~/.config/waybar/windows.jsonc -s ~/.config/waybar/windows.css --log-level off &
//
// Vertical window list config: windows.jsonc (wlr/taskbar).

{
  "layer": "top",
  "position": "top",
  "height": 30,
  // gap between clock and tray (padding itself is 0 everywhere)
  "spacing": 8,
  "modules-right": ["clock", "tray"],
  "clock": {
    "interval": 30,
    "format": "{:%I:%M %p}",
    "tooltip-format": "{:%a, %d %b %G}"
  },
  "tray": {
    "icon-size": 14,
    "spacing": 5,
    // Hide Passive icons (e.g. Vesktop) to reduce tray popup issues on some
    // compositors.
    "show-passive-items": false
  }
}
